{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/auth/:match*", "destination": "/api/auth/:match*" },
    { "source": "/api/admin/:match*", "destination": "/api/admin/:match*" },
    { "source": "/api/evaluate", "destination": "/api/evaluate" },
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
